# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campusedge
# Set to true on hosted Postgres (Railway, Render, Vercel Postgres)
DATABASE_SSL=false

# --- Auth ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-before-deploying
JWT_EXPIRES_IN=7d

# --- Domain rules ---
GROUP_SIZE=4
CURRENT_SEMESTER=2024-Spring

# --- Seed script passwords (local only) ---
SEED_ADMIN_PASSWORD=admin12345
SEED_STUDENT_PASSWORD=student123
